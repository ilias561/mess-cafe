# Canonical site URL used in metadata, sitemap, and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://messcafe.gr

# Contact + booking forms deliver via WhatsApp click-to-chat (with a mailto:
# fallback) — entirely client-side, so NO keys are needed and nothing can be
# "missing in prod". The café's number + email come from content/settings/
# general.md (whatsapp / email). No Web3Forms or CallMeBot keys required.

# Optional fallback WhatsApp number for CTA links / floating button when the
# settings file lacks one (international format, no '+'). Settings wins if set.
NEXT_PUBLIC_WHATSAPP_NUMBER=306946614169

# Brevo newsletter popup (contacts-only API key, restricted and rotatable).
NEXT_PUBLIC_BREVO_API_KEY=
NEXT_PUBLIC_BREVO_LIST_ID=

# Cloudflare Web Analytics (cookieless) — https://dash.cloudflare.com/?to=/:account/web-analytics
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare R2 video CDN (run "npm run sync-r2" to upload public/videos/ to R2)
# Account ID: Cloudflare dashboard → right sidebar
# Access keys: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# URL shown in bucket Settings → Public access → R2.dev subdomain
NEXT_PUBLIC_VIDEO_BASE_URL=https://pub-xxxx.r2.dev
#
# Cloudflare Pages: if this is unset, `lib/media.ts` falls back to the project's
# public R2.dev host when CF_PAGES=1 so `next build` still inlines working video URLs.
